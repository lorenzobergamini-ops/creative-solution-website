# ============================================================
# Creative Solution — environment variables (template)
# ------------------------------------------------------------
# Copia questo file in .env.local per lo sviluppo locale e compila
# i valori reali SOLO lì (mai nel repo). In produzione imposta le
# stesse variabili nella dashboard di Vercel.
#
# Tutte le chiavi NEXT_PUBLIC_* sono esposte al browser: devono
# contenere solo chiavi pubbliche (supabase anon key, turnstile site
# key). Tutto il resto è riservato al server (service role, secrets).
# ============================================================

# ---- Supabase -------------------------------------------------
# URL del progetto (Supabase dashboard -> Project Settings -> API).
# NEXT_PUBLIC_SUPABASE_URL=

# Chiave anon (pubblica, usata dal client per letture pubbliche con RLS).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role (SOLO lato server, mai nel client o nel repo).
# Viene usata per tutte le scritture e per l'accesso ai dati privati.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (email transazionali) -----------------------------
# API key per l'invio di email (notifica preventivo, conferma cliente).
# SERVER-ONLY: mai nel client o nel repo. Senza RESEND_API_KEY o
# RESEND_FROM_EMAIL le email vengono saltate con un log: la build resta
# verde e il form non si blocca mai per un errore email.
# RESEND_API_KEY=
#
# Mittente verificato usato come "from" per tutte le email transazionali
# (es. no-reply@dominio.it). IMPORTANTE: prima della produzione devi
# verificare il dominio mittente su Resend (aggiungi i record SPF e DKIM
# indicati dalla dashboard; senza verifica l'invio fallisce).
# Il destinatario della notifica admin si configura nel pannello admin
# (Impostazioni -> "Email notifiche"); se vuoto si usa RESEND_FROM_EMAIL.
# RESEND_FROM_EMAIL=

# ---- Cloudflare Turnstile (anti-bot, form preventivo) ----------
# Chiave segreta (solo server, verifica del token).
# TURNSTILE_SECRET_KEY=

# Chiave del sito (pubblica, usata nel widget del form).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- App --------------------------------------------------------
# URL pubblico del sito (per link assoluti nelle email, es. https://...).
# NEXT_PUBLIC_APP_URL=

# ---- Personalizzazione ------------------------------------------
# Override opzionale dell'accent color (CSS variable --accent).
# Default definito in src/app/globals.css: verde lime elettrico #C8F031.
# Alternativa documentata: arancione acceso #F97316.
# NB: il progetto funziona anche senza questa variabile.
# NEXT_PUBLIC_ACCENT_COLOR=#C8F031